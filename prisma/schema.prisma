generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  shortId   Int      @unique @default(autoincrement())
  name      String?
  email     String?  @unique
  phone     String?  @unique
  // The email Supabase Auth actually uses as this row's identity key. Equals `email` for
  // email-first customers; a generated synthetic placeholder (see syntheticEmailForPhone in
  // src/lib/auth.ts) for phone-only ones. Deliberately NULLABLE: Postgres permits multiple NULLs
  // under a UNIQUE constraint, and the backfill design in syncPrismaUser/
  // resolveCustomerForPhoneLogin needs a null state to backfill INTO for rows an admin created
  // ahead of the customer's first login.
  //
  // NEVER rendered, exported, or included in any notification — it is an internal Supabase-identity
  // implementation detail, not contact info. Client-facing queries omit it explicitly
  // (see `omit: { authEmail: true }` in admin/customers/actions.ts and admin/orders/actions.ts).
  authEmail String?  @unique
  // Which channel this customer is told to log in with at account-creation time. Never
  // auto-mutated by a later contact-info edit — manual admin edit only (locked product decision).
  preferredLoginMethod LoginMethod @default(EMAIL)
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

enum Role {
  ADMIN
  CUSTOMER
}

enum LoginMethod {
  EMAIL
  PHONE
}

/**
 * A single issued phone-login OTP. The code itself is NEVER stored — only an HMAC-SHA256 digest
 * of it (see src/lib/otp.ts), so a database dump can't be replayed into a login.
 */
model OtpCode {
  id         String    @id @default(uuid())
  phone      String    // E.164, the output of the existing toGhanaE164()
  codeHash   String    // HMAC-SHA256(code, OTP_HASH_SECRET) — never plaintext
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  // Both lookups in login/actions.ts filter by phone and order by createdAt — the cooldown check
  // and the verify-candidate lookup.
  @@index([phone, createdAt])
}

/**
 * Application-level singleton — see getNotificationSettings() in src/lib/settings.ts. Deliberately
 * uses this schema's standard `String @id @default(uuid())` convention rather than a fixed-literal
 * integer PK: a second primary-key pattern for two tables would be a bigger inconsistency than the
 * tiny, self-healing race on the very first read.
 *
 * This table is the SOLE source of truth for provider credentials once its row exists. There is no
 * env-var fallback anywhere in the sender modules, deliberately — a stale env var could otherwise
 * keep a channel sending after an admin explicitly toggled it off here.
 */
/**
 * On/off toggles ONLY — provider credentials (Resend/Arkesel/WhatsApp keys, sender IDs, template
 * names) live in .env, exactly as before this table existed, and are never admin-editable. This
 * table exists purely so the admin can silence a channel from the UI without a redeploy; it was
 * briefly over-scoped to also hold raw credentials and was reverted (see docs/ROADMAP.md).
 */
model NotificationSettings {
  id              String   @id @default(uuid())
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(true)
  whatsappEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/**
 * Separate singleton from NotificationSettings on purpose: login availability and alert delivery
 * are independently toggleable, so an admin can keep SMS notifications running while still
 * deciding phone login isn't ready for customers yet.
 */
model LoginSettings {
  id                String   @id @default(uuid())
  emailLoginEnabled Boolean  @default(true)
  // Opt-in on purpose — email-only login stays the default, unaffected behavior until the admin
  // has verified real SMS delivery post-deploy. See the Rollout Plan in docs/tdd-auth-settings.md.
  phoneLoginEnabled Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model InventoryItem {
  id              String   @id @default(uuid())
  name            String
  category        Category
  unit            String   // e.g., kg, pieces, crates
  currentStock    Float    @default(0)
  minimumThreshold Float   @default(0)
  isActive        Boolean  @default(true) // archived (false) rather than deleted whenever an
                                          // OrderIngredientLog or DishIngredient row references it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderLogs       OrderIngredientLog[]
  dishIngredients DishIngredient[]
}

enum Category {
  INGREDIENT
  DRINK
  PACKAGING
  OTHER
}

model Order {
  id          String   @id @default(uuid())
  shortId     Int      @unique @default(autoincrement())
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  description String   // e.g., "40 pies, 40 bowls of jollof"
  status      OrderStatus @default(PENDING)
  totalPrice  Float    @default(0)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredientLogs OrderIngredientLog[]
  dishes         OrderDish[]
}

enum OrderStatus {
  PENDING
  PREPPING
  COOKING
  READY
  COMPLETED
  CANCELLED
}

model OrderIngredientLog {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityUsed    Float    // Amount deducted from inventory
  createdAt       DateTime @default(now())
}

model Dish {
  id          String   @id @default(uuid())
  shortId     Int      @unique @default(autoincrement())
  name        String
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients DishIngredient[]
  orderDishes OrderDish[]
}

model DishIngredient {
  id              String        @id @default(uuid())
  dishId          String
  dish            Dish          @relation(fields: [dishId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityPerDish Float         // amount of InventoryItem.unit consumed per ONE unit of the dish
  createdAt       DateTime      @default(now())

  @@unique([dishId, inventoryItemId]) // one row per (dish, ingredient) — no silent duplicates
}

model OrderDish {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id])
  dishName  String   // snapshot of Dish.name at order time — survives a later rename/archive
  unitPrice Float    // snapshot of Dish.price at order time
  quantity  Int
  createdAt DateTime @default(now())
}
