generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  shortId   Int      @unique @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?  @unique
  // Archived (false) rather than deleted whenever the customer has orders on file — mirrors the
  // InventoryItem/Dish isActive pattern below.
  isActive  Boolean  @default(true)
  // The email Supabase Auth actually uses as this row's identity key. Equals `email` for
  // email-first customers; a generated synthetic placeholder (see syntheticEmailForPhone in
  // src/lib/auth.ts) for phone-only ones. Deliberately NULLABLE: Postgres permits multiple NULLs
  // under a UNIQUE constraint, and the backfill design in syncPrismaUser/
  // resolveCustomerForPhoneLogin needs a null state to backfill INTO for rows an admin created
  // ahead of the customer's first login.
  //
  // NEVER rendered, exported, or included in any notification — it is an internal Supabase-identity
  // implementation detail, not contact info. Client-facing queries omit it explicitly
  // (see `omit: { authEmail: true }` in admin/customers/actions.ts and admin/orders/actions.ts).
  authEmail String?  @unique
  // Which channel this customer is told to log in with at account-creation time. Never
  // auto-mutated by a later contact-info edit — manual admin edit only (locked product decision).
  preferredLoginMethod LoginMethod @default(EMAIL)
  // Per-customer notification-channel opt-in — independent of, and checked ALONGSIDE,
  // NotificationSettings' global admin toggle. A channel only actually sends when BOTH are true.
  notifyByEmail    Boolean @default(true)
  notifyBySms      Boolean @default(true)
  notifyByWhatsapp Boolean @default(true)
  // Where this customer's OWN order-update alerts actually go — deliberately separate from
  // email/phone above (the write-once LOGIN identity) and NOT unique: an alert destination isn't
  // an identity, so nothing stops two customers sharing one (e.g. a family WhatsApp number), and
  // it's freely editable at any time, unlike login email/phone. Null means "not customized yet" —
  // the call site in admin/orders/actions.ts falls back to this customer's login email/phone when
  // the matching alert field is unset, so notifications work out of the box before anyone visits
  // the dashboard's Notifications section.
  alertEmail    String?
  alertPhone    String?
  alertWhatsapp String?
  notes         String?
  // Stable public MinIO URL, or null. Technically available on every User row (admin included),
  // but only ever set/read via the Customer screens today. Not sensitive the way authEmail is,
  // so it is deliberately NOT added to the OMIT_AUTH_EMAIL per-query omit.
  imageUrl  String?
  role      Role     @default(CUSTOMER)
  createdAsRole Role @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  auditLogs AuditLog[]
}

enum Role {
  ADMIN
  KITCHEN_STAFF
  DELIVERY_DRIVER
  CUSTOMER
}

enum LoginMethod {
  EMAIL
  PHONE
}

/**
 * A single issued phone-login OTP. The code itself is NEVER stored — only an HMAC-SHA256 digest
 * of it (see src/lib/otp.ts), so a database dump can't be replayed into a login.
 */
model OtpCode {
  id         String    @id @default(uuid())
  // E.164 phone (toGhanaE164 output) OR a trimmed, lowercased email address — one generic column
  // rather than two, so phone-login OTP and the customer-dashboard add-a-missing-contact flow
  // share one model and one query shape instead of two nearly-identical ones.
  identifier String
  codeHash   String    // HMAC-SHA256(code, OTP_HASH_SECRET) — never plaintext
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  // Every lookup filters by identifier and orders by createdAt — the cooldown check and the
  // verify-candidate lookup, for both phone login and email/phone contact verification.
  @@index([identifier, createdAt])
}

/**
 * Application-level singleton — see getNotificationSettings() in src/lib/settings.ts. Deliberately
 * uses this schema's standard `String @id @default(uuid())` convention rather than a fixed-literal
 * integer PK: a second primary-key pattern for two tables would be a bigger inconsistency than the
 * tiny, self-healing race on the very first read.
 *
 * Owner/admin notification config — a per-channel on/off toggle PLUS the destination contact that
 * channel alerts (e.g. low-stock) go to. Provider credentials (Resend/Arkesel/WhatsApp API keys,
 * sender IDs, template names) still live in .env and are never admin-editable — only "where do MY
 * alerts go" and "is this channel on" are DB-backed. Replaces the old ADMIN_ALERT_EMAIL/
 * ADMIN_ALERT_PHONE env vars: the admin now enters her own alert contacts at /admin/settings, and
 * they can differ from her login identity (ADMIN_EMAIL/ADMIN_PHONE) or from each other — e.g. a
 * WhatsApp number that isn't the same as her SMS/login number.
 */
model NotificationSettings {
  id              String   @id @default(uuid())
  emailEnabled    Boolean  @default(true)
  alertEmail      String?
  smsEnabled      Boolean  @default(true)
  alertPhone      String?
  whatsappEnabled Boolean  @default(true)
  alertWhatsapp   String?
  updatedAt       DateTime @updatedAt
}

model InventoryItem {
  id              String   @id @default(uuid())
  name            String
  category        Category
  unit            String   // e.g., kg, pieces, crates
  currentStock    Float    @default(0)
  minimumThreshold Float   @default(0)
  isActive        Boolean  @default(true) // archived (false) rather than deleted whenever an
                                          // OrderIngredientLog or DishIngredient row references it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderLogs       OrderIngredientLog[]
  dishIngredients DishIngredient[]
  adjustments     StockAdjustmentLog[]
}

enum Category {
  INGREDIENT
  DRINK
  PACKAGING
  OTHER
}

model Order {
  id          String   @id @default(uuid())
  shortId     Int      @unique @default(autoincrement())
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  description String   // e.g., "40 pies, 40 bowls of jollof"
  notes       String?  // Optional bulleted notes
  deliveryAddress String?
  deliveryPhone   String?
  status      OrderStatus @default(PENDING)
  totalPrice  Float    @default(0)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredientLogs OrderIngredientLog[]
  dishes         OrderDish[]
}

enum OrderStatus {
  PENDING
  PREPPING
  COOKING
  READY
  COMPLETED
  CANCELLED
}

model OrderIngredientLog {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityUsed    Float    // Amount deducted from inventory
  createdAt       DateTime @default(now())
}

model Dish {
  id          String   @id @default(uuid())
  shortId     Int      @unique @default(autoincrement())
  name        String
  price       Float
  servingSize Int      @default(1) // recipe ingredient quantities cover this many units (1 = per-unit, 10 = per-10-bowls)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients DishIngredient[]
  orderDishes OrderDish[]
  media       DishMedia[]
}

// A dish's photos and videos, ordered by `position`. Replaces the single `Dish.imageUrl` scalar
// this model used to carry — a dish can now hold any number of media items.
// No onDelete clause on `dish`, matching this schema's established "zero onDelete anywhere, clean
// up explicitly in application code" convention — see deleteDish in src/app/admin/menu/actions.ts,
// which deletes these rows inside its own transaction before deleting the Dish.
model DishMedia {
  id        String    @id @default(uuid())
  dishId    String
  dish      Dish      @relation(fields: [dishId], references: [id])
  // Stable public MinIO URL (never a presigned/expiring one — it is rendered indefinitely).
  // See src/lib/storage/client.ts's buildPublicUrl.
  url       String
  type      MediaType
  // Display order, ascending; the lowest position is this dish's "cover". Deliberately NOT
  // @@unique per (dishId, position): reorderDishMedia swaps two rows' positions inside one
  // transaction, which a non-deferrable unique constraint would reject on the transient duplicate,
  // and nothing ever looks a row up BY position — only `ORDER BY position ASC` matters. Positions
  // are also never renumbered on removal, so gaps ([0, 2]) are expected, not a bug.
  position  Int
  createdAt DateTime  @default(now())

  @@index([dishId, position]) // query efficiency for the ordered read, NOT a uniqueness guarantee
}

enum MediaType {
  IMAGE
  VIDEO
}

model DishIngredient {
  id              String        @id @default(uuid())
  dishId          String
  dish            Dish          @relation(fields: [dishId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityPerDish Float         // amount of InventoryItem.unit consumed per ONE unit of the dish
  createdAt       DateTime      @default(now())

  @@unique([dishId, inventoryItemId]) // one row per (dish, ingredient) — no silent duplicates
}

model OrderDish {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id])
  dishName  String   // snapshot of Dish.name at order time — survives a later rename/archive
  unitPrice Float    // snapshot of Dish.price at order time
  quantity  Int
  createdAt DateTime @default(now())
}

model StockAdjustmentLog {
  id              String        @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  previousStock   Float
  newStock        Float
  reason          String?       // e.g., "STOCK_COUNT", "MANUAL_ADJUSTMENT"
  createdAt       DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
