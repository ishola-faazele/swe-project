# Chop with Rostty — environment variable template.
#
# This file did not exist in the repository before the Quick-Win Polish Pack
# (see docs/tdd-polish-pack.md, "Currency localization") — it is created here
# with the full set of env vars already read by the app (confirmed via grep
# across src/ and next.config.ts), not just the new currency var, so it's a
# genuinely complete template rather than a misleading partial one.
#
# Copy this file to .env (local dev) and fill in real values. Never commit .env.

# ── Database (Prisma → Postgres via Supabase) ──────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── Supabase Auth ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-supabase-anon-key"

# The app will not start without at least one of these set — whichever
# identity (email or phone) logs in matching this value is auto-assigned the
# ADMIN role on first login (src/app/auth/callback/route.ts, src/app/page.tsx).
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE=""

# Optional — where low-stock alert emails are sent. Falls back silently if unset
# (src/app/admin/orders/actions.ts).
ADMIN_ALERT_EMAIL=""

# Optional — the business owner's phone number for low-stock SMS/WhatsApp alerts
# (src/app/admin/orders/actions.ts → notifyLowStock). Falls back silently if
# unset, exactly like ADMIN_ALERT_EMAIL above: notifyLowStock's `if
# (data.adminPhone)` guard simply skips both phone channels.
ADMIN_ALERT_PHONE=""

# Used to build the magic-link redirect URL (src/app/login/actions.ts) and the
# post-login callback redirect (src/app/auth/callback/route.ts). Falls back to
# http://localhost:3000 if unset — set explicitly in any deployed environment.
# Must match the origin you actually browse to (127.0.0.1, not localhost, for
# local dev) or Supabase's PKCE cookie won't be found on the callback.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without this set, emails are not sent — src/lib/notifications/email.ts logs
# to the console instead. Safe to leave unset for local dev.
RESEND_API_KEY=""
FROM_EMAIL="Chop with Rostty <onboarding@resend.dev>"

# ── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# Read by src/lib/notifications/whatsapp.ts unless noted otherwise. Every sender
# is independently env-gated: with the first two unset, both senders no-op with
# { success: false, reason: 'whatsapp_not_configured' } and log to the console,
# exactly like RESEND_API_KEY does for email. Safe to leave unset for local dev.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Not read by any sender — documented for completeness / future use (checking
# message-template approval status lives on the WABA node).
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Read by src/app/api/webhooks/whatsapp/route.ts. Both FAIL CLOSED when unset —
# the GET verification handshake rejects with 403 and every POST rejects with
# 503, rather than silently accepting unverified requests from anyone.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Meta-approved message template names. These are two SEPARATE templates by
# design — WhatsApp templates carry fixed, pre-approved body text, so the
# order-status template's wording cannot be reused to carry a stock alert.
WHATSAPP_TEMPLATE_NAME="order_status_update"
WHATSAPP_LOW_STOCK_TEMPLATE_NAME="low_stock_alert"
# "en", not "en_US" — confirmed against this business's actual WhatsApp Manager
# templates (both registered under plain "English", not "English (US)"). A
# mismatch here fails with a very specific, easy-to-miss Graph API error
# (132001, "Template name does not exist in the translation") even when the
# template itself is approved and the name is spelled correctly.
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Graph API version segment in the send URL. Env-overridable so a future version
# bump needs no code change. Defaults to v24.0 in code if unset.
WHATSAPP_API_VERSION="v24.0"

# ── SMS (Arkesel) ───────────────────────────────────────────────────────────
# Read by src/lib/notifications/sms.ts. This account uses Arkesel's LEGACY v1
# query-string API (GET https://sms.arkesel.com/sms/api?action=send-sms&...),
# NOT the v2 REST API — api_key travels as a URL query parameter, not a header.
# With either unset, sendSms no-ops with { success: false, reason:
# 'sms_not_configured' } and logs instead. Safe to leave unset for local dev.
ARKESEL_API_KEY=""
# Sender ID shown to the recipient. Auto-registers on the fly on this account —
# no pre-approval step needed.
ARKESEL_SENDER_ID="Rostty"

# ── Currency localization (Quick-Win Polish Pack) ───────────────────────────
# Must be NEXT_PUBLIC_-prefixed: read by both server- and client-rendered price
# displays (src/lib/currency.ts). A 3-letter ISO 4217 code. Statically inlined
# at build time — changing this value requires a rebuild/restart, not just an
# env reload. Defaults to GHS (Ghanaian Cedi) if unset or invalid — the
# business operates in Ghana, confirmed directly by the owner.
NEXT_PUBLIC_CURRENCY="GHS"
