# ==========================================
# Chop with Rostty - Environment Variables
# ==========================================

# Supabase Configuration (Local or Remote)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Prisma Database Configuration
# DATABASE_URL: Connection pooled connection string (port 54322 locally)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# DIRECT_URL: Direct session connection string for migrations (port 54322 locally)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Resend Email Configuration (https://resend.com)
# Leave blank to skip sending emails (fallback to console logs in development)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL="Chop with Rostty <orders@yourdomain.com>"

# Role-based Authorization & Notifications
# Users logging in with ADMIN_EMAIL or ADMIN_PHONE get ADMIN privileges
ADMIN_EMAIL=admin@chopwithrostty.com
ADMIN_PHONE=+2348000000000
ADMIN_ALERT_EMAIL=admin@chopwithrostty.com

# Site URL (Used for Supabase Auth Magic Link Redirects)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
