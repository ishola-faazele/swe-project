# Chop with Rosty — environment variable template.
#
# This file did not exist in the repository before the Quick-Win Polish Pack
# (see docs/tdd-polish-pack.md, "Currency localization") — it is created here
# with the full set of env vars already read by the app (confirmed via grep
# across src/ and next.config.ts), not just the new currency var, so it's a
# genuinely complete template rather than a misleading partial one.
#
# Copy this file to .env (local dev) and fill in real values. Never commit .env.

# ── Database (Prisma → Postgres via Supabase) ──────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── Supabase Auth ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-supabase-anon-key"

# The app will not start without at least one of these set — whichever
# identity (email or phone) logs in matching this value is auto-assigned the
# ADMIN role on first login (src/app/auth/callback/route.ts, src/app/page.tsx).
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE=""

# Optional — where low-stock alert emails are sent. Falls back silently if unset
# (src/app/admin/orders/actions.ts).
ADMIN_ALERT_EMAIL=""

# Used to build the magic-link redirect URL (src/app/login/actions.ts).
# Falls back to http://localhost:3000 if unset — set explicitly in any
# deployed environment.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without this set, emails are not sent — src/lib/notifications/email.ts logs
# to the console instead. Safe to leave unset for local dev.
RESEND_API_KEY=""
FROM_EMAIL="Chop with Rosty <onboarding@resend.dev>"

# ── SMS (stub — no real provider wired up yet) ──────────────────────────────
# Referenced by src/lib/notifications/sms.ts but not currently connected to a
# real provider; included here for forward-compatibility only.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Currency localization (Quick-Win Polish Pack) ───────────────────────────
# Must be NEXT_PUBLIC_-prefixed: read by both server- and client-rendered price
# displays (src/lib/currency.ts). A 3-letter ISO 4217 code. Statically inlined
# at build time — changing this value requires a rebuild/restart, not just an
# env reload. Defaults to GHS (Ghanaian Cedi) if unset or invalid — the
# business operates in Ghana, confirmed directly by the owner.
NEXT_PUBLIC_CURRENCY="GHS"
