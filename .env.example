# Chop with Rostty — environment variable template.
#
# This file did not exist in the repository before the Quick-Win Polish Pack
# (see docs/tdd-polish-pack.md, "Currency localization") — it is created here
# with the full set of env vars already read by the app (confirmed via grep
# across src/ and next.config.ts), not just the new currency var, so it's a
# genuinely complete template rather than a misleading partial one.
#
# Copy this file to .env (local dev) and fill in real values. Never commit .env.

# ── Database (Prisma → Postgres via Supabase) ──────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── Supabase Auth ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-supabase-anon-key"

# ⚠️  SERVER-ONLY. BYPASSES ROW LEVEL SECURITY ENTIRELY. ⚠️
# NEVER prefix this with NEXT_PUBLIC_ — that would inline it into the browser bundle and hand
# every visitor full, unrestricted database access. Only src/utils/supabase/admin.ts may read it.
# Never import that module from a "use client" component.
#
# Used for supabase.auth.admin.generateLink(), which powers two things: minting a session for a
# phone-OTP login (src/lib/auth.ts → mintSessionForAuthEmail) and building the click-to-log-in
# link in a new customer's account-creation email (src/app/admin/customers/actions.ts).
# Without it, both of those fail gracefully as an ActionResult error rather than crashing — but
# phone login is entirely non-functional. The value below is Supabase's well-known LOCAL demo key
# (identical on every machine, safe to share); production needs the real value from the owner's
# Supabase project API settings.
SUPABASE_SERVICE_ROLE_KEY="your-local-supabase-service-role-key"

# HMAC-SHA256 pepper used by src/lib/otp.ts to hash phone-login OTP codes before they are stored.
# Codes are NEVER written to the database in plaintext. hashOtpCode() throws if this is unset, so
# phone-OTP login is entirely broken without it. Rotating it invalidates every outstanding
# unexpired code — a documented, accepted side effect. Generate once per environment, e.g.
# `openssl rand -hex 32`.
OTP_HASH_SECRET="a-long-random-string-generated-once-per-environment"

# The app will not start without at least one of these set — whichever
# identity (email or phone) logs in matching this value is auto-assigned the
# ADMIN role on first login (src/app/auth/callback/route.ts, src/app/page.tsx).
# This is LOGIN identity only. Where the owner's own low-stock alerts are SENT
# (email/phone/WhatsApp) is a separate, DB-backed setting she manages herself at
# /admin/settings → Notifications — not an env var, and can differ from these.
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE=""

# Used to build the magic-link redirect URL (src/app/login/actions.ts) and the
# post-login callback redirect (src/app/auth/callback/route.ts). Falls back to
# http://localhost:3000 if unset — set explicitly in any deployed environment.
# Must match the origin you actually browse to (127.0.0.1, not localhost, for
# local dev) or Supabase's PKCE cookie won't be found on the callback.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# ── Notification channels ───────────────────────────────────────────────────
# Every provider credential below lives here in .env, set by a developer at deploy time — NEVER
# in the database, and NEVER editable through /admin/settings. The Settings UI only holds a
# simple on/off toggle per channel (emailEnabled/smsEnabled/whatsappEnabled on the
# NotificationSettings row) — flipping a channel off there makes its sender no-op with
# reason: '{channel}_disabled' regardless of whether the credentials below are set. Flipping a
# channel on with nothing set below still no-ops, just with a different reason
# ('no_api_key'/'sms_not_configured'/'whatsapp_not_configured') — "enabled" and "configured" are
# always two independent checks.

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
FROM_EMAIL="Chop with Rostty <onboarding@resend.dev>"

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Not read by any sender — documented for completeness / future use (checking
# message-template approval status lives on the WABA node).
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Read by src/app/api/webhooks/whatsapp/route.ts. Both FAIL CLOSED when unset — the GET
# verification handshake rejects with 403 and every POST rejects with 503, rather than silently
# accepting unverified requests from anyone.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Meta-approved message template names. These are two SEPARATE templates by design — WhatsApp
# templates carry fixed, pre-approved body text, so the order-status template's wording cannot be
# reused to carry a stock alert.
WHATSAPP_TEMPLATE_NAME="order_status_update"
WHATSAPP_LOW_STOCK_TEMPLATE_NAME="low_stock_alert"
# "en", not "en_US" — confirmed against this business's actual WhatsApp Manager templates (both
# registered under plain "English", not "English (US)"). A mismatch here fails with a very
# specific, easy-to-miss Graph API error (132001, "Template name does not exist in the
# translation") even when the template itself is approved and the name is spelled correctly.
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Graph API version segment in the send URL, read by whatsapp.ts's graphUrl() helper.
# Env-overridable so a future version bump needs no code change. Defaults to v24.0 in code if unset.
WHATSAPP_API_VERSION="v24.0"

# ── SMS (Arkesel) ────────────────────────────────────────────────────────────
# This account uses Arkesel's LEGACY v1 query-string API
# (GET https://sms.arkesel.com/sms/api?action=send-sms&...), NOT the v2 REST API — api_key
# travels as a URL query parameter, not a header.
ARKESEL_API_KEY=""
# Sender ID shown to the recipient. Auto-registers on the fly on this account —
# no pre-approval step needed.
ARKESEL_SENDER_ID="Rostty"

# ── Object Storage (MinIO, local dev via docker-compose.yml) ────────────────
# Powers admin-only dish/customer photo uploads. The browser uploads DIRECTLY to MinIO using a
# short-lived presigned PUT URL minted by getMediaUploadUrl (src/lib/storage/actions.ts) — file
# bytes never pass through the Next.js server. Bring the stack up separately from Supabase with
# `docker compose up -d` (or `npm run minio:up`); it shares no lifecycle with `supabase start`.

# Browser-reachable address for MinIO's S3 API. Used BOTH server-side (to build the S3Client that
# generates presigned upload URLs) AND embedded directly into the resulting presigned PUT URL that
# the browser uses — these must be the SAME reachable host, because a presigned URL's signature is
# bound to its exact host and cannot be swapped after signing. In this project the Next.js server
# is never itself Dockerized (it always runs on the host via `npm run dev`), so 127.0.0.1 is
# correct here — do NOT set this to the Docker-internal `http://minio:9000`, which the browser
# could never reach. Unset: presigning throws and every upload fails at the picker.
MINIO_ENDPOINT="http://127.0.0.1:9000"

# Optional override, defaults to MINIO_ENDPOINT if unset. Used ONLY to construct the stable public
# URL stored in DishMedia.url/User.imageUrl (never for presigning). Reserved for a future
# production deployment behind a reverse proxy/CDN domain — see the TDD's Open Questions for why
# this alone does not solve that problem for the PUT side.
MINIO_PUBLIC_ENDPOINT=""

# ⚠️  SERVER-ONLY S3 credentials. NEVER prefix either with NEXT_PUBLIC_ — that would inline the
# bucket's write credentials into the browser bundle. Only src/lib/storage/client.ts reads them.
# Same precedent as SUPABASE_SERVICE_ROLE_KEY above. The values below are the local-dev defaults
# baked into docker-compose.yml's MINIO_ROOT_USER/MINIO_ROOT_PASSWORD — safe to share because that
# MinIO only ever listens on 127.0.0.1; any real deployment needs real, rotated credentials.
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

# Bucket name. MUST match the bucket docker-compose.yml's `minio-init` service creates and applies
# `mc anonymous set download` to — a mismatch presigns URLs against a bucket that doesn't exist,
# and the failure only surfaces at the browser's PUT (see the TDD's Edge Cases).
MINIO_BUCKET="chop-uploads"

# Required by the AWS SDK's S3Client constructor, which rejects an empty region. MinIO itself
# ignores the value entirely. Defaults to us-east-1 in code if unset.
MINIO_REGION="us-east-1"

# ── Currency localization (Quick-Win Polish Pack) ───────────────────────────
# Must be NEXT_PUBLIC_-prefixed: read by both server- and client-rendered price
# displays (src/lib/currency.ts). A 3-letter ISO 4217 code. Statically inlined
# at build time — changing this value requires a rebuild/restart, not just an
# env reload. Defaults to GHS (Ghanaian Cedi) if unset or invalid — the
# business operates in Ghana, confirmed directly by the owner.
NEXT_PUBLIC_CURRENCY="GHS"
